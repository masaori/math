{
  // 日本語版 ../structured-latex/tsconfig.json と同じ設定にする（strict の水準を二重管理しない）。
  // 継承元は入力言語の正本であるシステム（リポジトリ直下 structured-latex/）が持つ base である。
  "extends": "../../structured-latex/tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "schema.ts",
    "frontmatter.ts",
    "labels.generated.ts",
    "document.generated.ts",
    "content",
    "notes",
    "tools",
    "type-tests"
  ],
  "exclude": ["type-tests/.tmp", "node_modules", "logs"]
}
