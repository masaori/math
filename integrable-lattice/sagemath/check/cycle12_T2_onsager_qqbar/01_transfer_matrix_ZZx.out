=== Step 1–2: T(x) ∈ M(ℤ[x]) と Tr T^L = Z_L(x) ===
L=2: dim T = 4, 全成分∈ℤ[x] = True, 全成分が単項式 x^k = True
      Tr T^L == Z_L(bruteforce) : True
      Z_L(x) = 2*x^8 + 12*x^4 + 2
      Σ係数 = 16 == 2^(L²) = 16 : True
L=3: dim T = 8, 全成分∈ℤ[x] = True, 全成分が単項式 x^k = True
      Tr T^L == Z_L(bruteforce) : True
      Z_L(x) = 102*x^12 + 144*x^10 + 198*x^8 + 48*x^6 + 18*x^4 + 2
      Σ係数 = 512 == 2^(L²) = 512 : True
L=4: dim T = 16, 全成分∈ℤ[x] = True, 全成分が単項式 x^k = True
      Tr T^L == Z_L(bruteforce) : True
      Z_L(x) = 2*x^32 + 32*x^28 + 64*x^26 + 424*x^24 + 1728*x^22 + 6688*x^20 + 13568*x^18 + 20524*x^16 + 13568*x^14 + 6688*x^12 + 1728*x^10 + 424*x^8 + 64*x^6 + 32*x^4 + 2
      Σ係数 = 65536 == 2^(L²) = 65536 : True

=== Step 2': 特性多項式 det(λI − T(x)) ∈ ℤ[x][λ] ===
L=2: 係数が全て ℤ[x] の元 = True
      charpoly の ℚ(x)[λ] 上の因数分解:
        (lam + x^2 - 1) * (lam + x^4 - x^2) * (lam^2 + (-x^4 - 2*x^2 - 1)*lam + x^6 - 2*x^4 + x^2)
L=3: 係数が全て ℤ[x] の元 = True
      charpoly の ℚ(x)[λ] 上の因数分解:
        (lam - x^5 + x^4 + x^3 - x^2)^2 * (lam + x^5 + x^4 - x^3 - x^2)^2 * (lam^2 + (-x^5 - 2*x^4 - 3*x^3 - x^2 - 1)*lam + x^8 + 2*x^7 - x^6 - 4*x^5 - x^4 + 2*x^3 + x^2) * (lam^2 + (x^5 - 2*x^4 + 3*x^3 - x^2 - 1)*lam + x^8 - 2*x^7 - x^6 + 4*x^5 - x^4 - 2*x^3 + x^2)
