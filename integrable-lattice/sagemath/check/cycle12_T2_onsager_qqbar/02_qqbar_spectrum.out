=== Step 3: 有理点 x=q での T(q) スペクトルの ℚ̄ 帰属 ===
（臨界点 x_c = √2 − 1 = 0.414213562373095。q > x_c は高温側、q < x_c は低温側）

--- q = 1/2 (高温側) ---
  L=2: dim=4, 全固有値∈QQbar=True, 全実=True, 全正=True
        最小多項式の次数集合=[1, 2], すべて2冪=True
        charpoly の ℚ[λ] 因数分解 = (x - 3/4) * (x - 3/16) * (x^2 - 25/16*x + 9/64)
        λ_max = 1.46661600623317 , minpoly(λ_max) = x^2 - 25/16*x + 9/64 (deg 2, 既約=True)
  L=3: dim=8, 全固有値∈QQbar=True, 全実=True, 全正=True
        最小多項式の次数集合=[1, 2], すべて2冪=True
        charpoly の ℚ[λ] 因数分解 = (x - 9/32)^2 * (x - 3/32)^2 * (x^2 - 57/32*x + 81/256) * (x^2 - 31/32*x + 9/256)
        λ_max = 1.58113686856201 , minpoly(λ_max) = x^2 - 57/32*x + 81/256 (deg 2, 既約=True)
  L=4: dim=16, 全固有値∈QQbar=True, 全実=True, 全正=True
        最小多項式の次数集合=[1, 2, 4], すべて2冪=True
        charpoly の ℚ[λ] 因数分解 = (x - 27/64)^2 * (x - 3/64)^2 * (x - 9/64)^4 * (x^2 - 75/64*x + 81/1024) * (x^2 - 75/256*x + 81/16384) * (x^4 - 553/256*x^3 + 5949/8192*x^2 - 44793/1048576*x + 6561/16777216)
        λ_max = 1.76161735350579 , minpoly(λ_max) = x^4 - 553/256*x^3 + 5949/8192*x^2 - 44793/1048576*x + 6561/16777216 (deg 4, 既約=True)

--- q = 1/3 (低温側) ---
  L=2: dim=4, 全固有値∈QQbar=True, 全実=True, 全正=True
        最小多項式の次数集合=[1, 2], すべて2冪=True
        charpoly の ℚ[λ] 因数分解 = (x - 8/9) * (x - 8/81) * (x^2 - 100/81*x + 64/729)
        λ_max = 1.15880770862867 , minpoly(λ_max) = x^2 - 100/81*x + 64/729 (deg 2, 既約=True)
  L=3: dim=8, 全固有値∈QQbar=True, 全実=True, 全正=True
        最小多項式の次数集合=[1, 2], すべて2冪=True
        charpoly の ℚ[λ] 因数分解 = (x - 32/243)^2 * (x - 16/243)^2 * (x^2 - 304/243*x + 1024/6561) * (x^2 - 248/243*x + 256/6561)
        λ_max = 1.11048295844136 , minpoly(λ_max) = x^2 - 304/243*x + 1024/6561 (deg 2, 既約=True)
  L=4: dim=16, 全固有値∈QQbar=True, 全実=True, 全正=True
        最小多項式の次数集合=[1, 2, 4], すべて2冪=True
        charpoly の ℚ[λ] 因数分解 = (x - 128/729)^2 * (x - 32/729)^2 * (x - 64/729)^4 * (x^2 - 800/729*x + 4096/59049) * (x^2 - 800/6561*x + 4096/4782969) * (x^4 - 8848/6561*x^3 + 1353728/4782969*x^2 - 36241408/3486784401*x + 16777216/282429536481)
        λ_max = 1.09976904129854 , minpoly(λ_max) = x^4 - 8848/6561*x^3 + 1353728/4782969*x^2 - 36241408/3486784401*x + 16777216/282429536481 (deg 4, 既約=True)

--- q = 2/5 (低温側) ---
  L=2: dim=4, 全固有値∈QQbar=True, 全実=True, 全正=True
        最小多項式の次数集合=[1, 2], すべて2冪=True
        charpoly の ℚ[λ] 因数分解 = (x - 21/25) * (x - 84/625) * (x^2 - 841/625*x + 1764/15625)
