        charpoly の ℚ[λ] 因数分解 = (x - 4116/15625)^2 * (x - 756/15625)^2 * (x - 1764/15625)^4 * (x^2 - 17661/15625*x + 777924/9765625) * (x^2 - 70644/390625*x + 12446784/6103515625) * (x^4 - 619081/390625*x^3 + 2650872168/6103515625*x^2 - 1926391871376/95367431640625*x + 9682651996416/59604644775390625)
        λ_max = 1.25031897657641 , minpoly(λ_max) = x^4 - 619081/390625*x^3 + 2650872168/6103515625*x^2 - 1926391871376/95367431640625*x + 9682651996416/59604644775390625 (deg 4, 既約=True)
