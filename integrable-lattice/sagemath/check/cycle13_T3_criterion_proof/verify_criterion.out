[d = 2（ℓ=2 は仮定外, ℓ=3 は成立）]  ℓ = 2
    det L(z) = -2*z^-4 - z^-2 + 6 - z^2 - 2*z^4
    d = 2,  content_z = 1
    (☆) v_ℓ(content) = 0 ,  Weierstrass μ(f) = 0 ,  一致 = True
    Weierstrass λ(f) = 4  →  塔の λ 予測 = λ(f) − 1 = 3
    ℓ | d → 全ての n ≥ 1 で X_{ℓ^n} は非連結（定理の仮定外）。
    確認: κ_n = 0 (n=1..): True

[d = 2（ℓ=3 は成立）]  ℓ = 3
    det L(z) = -2*z^-4 - z^-2 + 6 - z^2 - 2*z^4
    d = 2,  content_z = 1
    (☆) v_ℓ(content) = 0 ,  Weierstrass μ(f) = 0 ,  一致 = True
