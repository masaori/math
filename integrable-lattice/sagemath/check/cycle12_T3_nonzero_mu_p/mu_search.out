       content=23, 辺重複度 gcd=1（1 なら ℓ 重多重グラフではない）, 予測 μ={}
    A=(0, 0, 2) B=(1,) C=(1, 1): det L = -17*z^-1 + 34 - 17*z
       content=17, 辺重複度 gcd=1（1 なら ℓ 重多重グラフではない）, 予測 μ={}
    A=(0, 0, 2) B=(1, 1) C=(1,): det L = -17*z^-1 + 34 - 17*z
       content=17, 辺重複度 gcd=1（1 なら ℓ 重多重グラフではない）, 予測 μ={}
    A=(0, 2, 2) B=(1,) C=(1, 1): det L = -17*z^-1 + 34 - 17*z
       content=17, 辺重複度 gcd=1（1 なら ℓ 重多重グラフではない）, 予測 μ={}
