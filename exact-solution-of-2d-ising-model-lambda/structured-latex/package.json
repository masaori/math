{
  "name": "@ising-lambda/structured-latex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "2次元Ising模型の厳密解をΛ・Fisher零点の立場から導出する証明本体（構造化テキスト）。入力言語はリポジトリ直下 structured-latex/ のシステムを使い、量の住処（可算/非可算）と ℝ 脱出の宣言をプロジェクト固有メタデータとして足す。",
  "scripts": {
    "gen": "node ../../structured-latex/codegen/structured-text-index/cli.ts --project .",
    "check:generated": "node ../../structured-latex/codegen/structured-text-index/cli.ts --project . --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node tools/validate-content.ts",
    "validate:lean": "node tools/verify-lean-linkage.ts",
    "test:types": "node tools/negative-type-test.ts",
    "test:runtime": "node tools/schema-runtime-test.ts",
    "build:tex": "node tools/build-latex.ts",
    "build:pdf": "node tools/build-latex.ts --pdf && node tools/verify-no-notes-in-output.ts",
    "verify:no-notes": "node tools/build-latex.ts && node tools/verify-no-notes-in-output.ts",
    "check": "npm run check:generated && npm run typecheck && npm run validate && npm run validate:lean && npm run verify:no-notes && npm run test:types && npm run test:runtime"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
