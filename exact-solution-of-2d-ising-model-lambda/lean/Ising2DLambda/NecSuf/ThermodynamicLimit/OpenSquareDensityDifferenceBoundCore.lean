/-
「差の一様な評価に現れる量は核の基準辺分の一倍である」の必要十分版。

具体版が使うのは、(1) 有理数倍の加法への分配則 `r·(x+y) = r·x + r·y`、(2) 有理数倍の結合則
`(r s)·x = r·(s·x)`、(3) 有理数倍と逆元の順序の入れ替え `r·(−x) = −(r·x)`、そして ℚ の四則
`(1/a)·2 = 2/a`・`(1/a)·4 = 4/a` だけである。(3) を具体版は素数ごとの ℚ の四則で示すが、
必要十分版では三つとも仮定として受ける。したがって型 `X` には `Add`・`Neg`・`SMul ℚ X` だけがあればよく、
加法群の公理（結合則・交換則・単位元・逆元律）も、加法単調性も、順序も要らない。
係数の側は ℚ のままである（`(1/a)·2 = 2/a` を ℚ の四則で使うため）。
-/
import Mathlib.Algebra.Group.Basic
import Mathlib.Algebra.Field.Rat
import Mathlib.Tactic.Ring

namespace Ising2DLambda.NecSuf.ThermodynamicLimit

variable {X : Type*} [Add X] [Neg X] [SMul ℚ X]

/-- 分配則・結合則・逆元との入れ替えだけから、核の `1/a` 倍が係数を `1/a` 倍した各項の和に等しいこと。 -/
theorem one_div_smul_core_eq_scaled_terms_necSuf
    (hdist : ∀ (r : ℚ) (x y : X), r • (x + y) = r • x + r • y)
    (hassoc : ∀ (r s : ℚ) (x : X), (r * s) • x = r • (s • x))
    (hneg : ∀ (r : ℚ) (x : X), r • (-x) = -(r • x))
    (a : ℕ) (g2 l1q lq : X) :
    ((1 : ℚ) / (a : ℚ)) •
        ((((2 : ℚ) • g2 + (4 : ℚ) • l1q) + -((4 : ℚ) • lq)) + (2 : ℚ) • (g2 + (2 : ℚ) • l1q)) =
      ((((2 : ℚ) / (a : ℚ)) • g2 + ((4 : ℚ) / (a : ℚ)) • l1q) + -(((4 : ℚ) / (a : ℚ)) • lq)) +
        ((2 : ℚ) / (a : ℚ)) • (g2 + (2 : ℚ) • l1q) := by
  have hq2 : (1 : ℚ) / (a : ℚ) * 2 = (2 : ℚ) / (a : ℚ) := by ring
  have hq4 : (1 : ℚ) / (a : ℚ) * 4 = (4 : ℚ) / (a : ℚ) := by ring
  -- 準備の第二
  have hX : ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • g2 + (4 : ℚ) • l1q) =
      ((2 : ℚ) / (a : ℚ)) • g2 + ((4 : ℚ) / (a : ℚ)) • l1q := by
    calc ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • g2 + (4 : ℚ) • l1q)
        = ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • g2) + ((1 : ℚ) / (a : ℚ)) • ((4 : ℚ) • l1q) :=
          hdist _ _ _
      _ = ((1 : ℚ) / (a : ℚ) * 2) • g2 + ((1 : ℚ) / (a : ℚ) * 4) • l1q := by
          rw [← hassoc, ← hassoc]
      _ = ((2 : ℚ) / (a : ℚ)) • g2 + ((4 : ℚ) / (a : ℚ)) • l1q := by rw [hq2, hq4]
  -- 準備の第三
  have hY : ((1 : ℚ) / (a : ℚ)) • (-((4 : ℚ) • lq)) = -(((4 : ℚ) / (a : ℚ)) • lq) := by
    calc ((1 : ℚ) / (a : ℚ)) • (-((4 : ℚ) • lq))
        = -(((1 : ℚ) / (a : ℚ)) • ((4 : ℚ) • lq)) := hneg _ _
      _ = -(((1 : ℚ) / (a : ℚ) * 4) • lq) := by rw [← hassoc]
      _ = -(((4 : ℚ) / (a : ℚ)) • lq) := by rw [hq4]
  -- 準備の第四
  have hC : ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • (g2 + (2 : ℚ) • l1q)) =
      ((2 : ℚ) / (a : ℚ)) • (g2 + (2 : ℚ) • l1q) := by
    calc ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • (g2 + (2 : ℚ) • l1q))
        = ((1 : ℚ) / (a : ℚ) * 2) • (g2 + (2 : ℚ) • l1q) := by rw [← hassoc]
      _ = ((2 : ℚ) / (a : ℚ)) • (g2 + (2 : ℚ) • l1q) := by rw [hq2]
  -- 本体
  calc ((1 : ℚ) / (a : ℚ)) •
        ((((2 : ℚ) • g2 + (4 : ℚ) • l1q) + -((4 : ℚ) • lq)) + (2 : ℚ) • (g2 + (2 : ℚ) • l1q))
      = ((1 : ℚ) / (a : ℚ)) • (((2 : ℚ) • g2 + (4 : ℚ) • l1q) + -((4 : ℚ) • lq)) +
          ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • (g2 + (2 : ℚ) • l1q)) := hdist _ _ _
    _ = (((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • g2 + (4 : ℚ) • l1q) +
          ((1 : ℚ) / (a : ℚ)) • (-((4 : ℚ) • lq))) +
          ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • (g2 + (2 : ℚ) • l1q)) := by rw [hdist]
    _ = ((((2 : ℚ) / (a : ℚ)) • g2 + ((4 : ℚ) / (a : ℚ)) • l1q) +
          ((1 : ℚ) / (a : ℚ)) • (-((4 : ℚ) • lq))) +
          ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • (g2 + (2 : ℚ) • l1q)) := by rw [hX]
    _ = ((((2 : ℚ) / (a : ℚ)) • g2 + ((4 : ℚ) / (a : ℚ)) • l1q) + -(((4 : ℚ) / (a : ℚ)) • lq)) +
          ((1 : ℚ) / (a : ℚ)) • ((2 : ℚ) • (g2 + (2 : ℚ) • l1q)) := by rw [hY]
    _ = ((((2 : ℚ) / (a : ℚ)) • g2 + ((4 : ℚ) / (a : ℚ)) • l1q) + -(((4 : ℚ) / (a : ℚ)) • lq)) +
          ((2 : ℚ) / (a : ℚ)) • (g2 + (2 : ℚ) • l1q) := by rw [hC]

end Ising2DLambda.NecSuf.ThermodynamicLimit
