{
  // 型検査の水準はシステムの正本（structured-latex/tsconfig.base.json）を継承する。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true,
    // バンドルは Vite が行い、tsc は検査専用。
    "noEmit": true
  },
  "include": ["src"]
}
