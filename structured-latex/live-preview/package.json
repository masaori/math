{
  "name": "@structured-latex/live-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "構造化テキストのレンダー結果を LAN 内でリアルタイム閲覧するビューア。structured-latex システムの上に載るモジュールで、入力言語も解決も自前では持たない。",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "start": "node backend/dist/entrypoint/server.js"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "engines": {
    "node": ">=22.18"
  }
}
