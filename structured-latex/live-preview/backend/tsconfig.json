{
  // 型検査の水準はシステムの正本（structured-latex/tsconfig.base.json）を継承する。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    // dist を出す。base の rewriteRelativeImportExtensions により、
    // システムの `.ts` 拡張子つき import は emit 時に `.js` へ書き換わる。
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
