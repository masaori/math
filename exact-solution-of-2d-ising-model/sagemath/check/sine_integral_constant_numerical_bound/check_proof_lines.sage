# 対象ラベル: sine_integral_constant_numerical_bound
# 証明: 準備 1 + c0 ≥ 1.5887 > 0。
#   12c0(1+c0) ≥ 12·0.5887·(1+c0) ≥ 12·0.5887·1.5887 = 11.22321228 ≥ 11.22。
#   B = π²/(12c0(1+c0)) ≤ 9.8697/(12c0(1+c0)) ≤ 9.8697/11.22 = 98697/112200 ≤ 98736/112200 = 0.88。
# 帰属:
# - 有理数の行（11.22321228、98697/112200、0.88）と大小比較は QQ で厳密に。
# - c0 を含む不等号の行は、「左辺 - 右辺」を c0 の不定元 c の QQ[c] の積に因数分解し、
#   c ≥ 0.5887 の下で各因子が非負であることで厳密に確かめる。
# - 主張そのものは、c0 と π² の入力の範囲（0.5887 ≤ c0、π² ≤ 9.8697）の最悪の場合の値が QQ で 0.88 以下になることで厳密に確かめ、
#   加えて π のボール（Arb）で B の値そのものを囲んで確かめる（π が QQ に入らないための ℝ への脱出）。
R.<c> = QQ[]
lo = QQ(5887)/10000
assert 1 + lo == QQ(15887)/10000                                                     # 準備
assert 12*c*(1 + c) - 12*lo*(1 + c) == 12*(1 + c)*(c - lo)                           # 1 行目: 12(1+c) > 0 と c - 0.5887 ≥ 0
assert 12*lo*(1 + c) - 12*lo*QQ(15887)/10000 == 12*lo*(c - lo)                       # 2 行目: 12·0.5887 > 0 と c - 0.5887 ≥ 0
assert 12*lo*QQ(15887)/10000 == QQ(1122321228)/10^8                                  # 3 行目
assert QQ(1122321228)/10^8 >= QQ(1122)/100                                           # 4 行目
print("12c0(1+c0) ≥ 11.22 の鎖が QQ[c] の因数分解と QQ で成り立つ")
pi2_up = QQ(98697)/10000
assert pi2_up / (QQ(1122)/100) == QQ(98697)/112200                                   # 4 行目
assert QQ(98697) <= QQ(98736) and QQ(98736)/112200 == QQ(88)/100                     # 5・6 行目
assert QQ(88)/100 * 112200 == 98736
# 2・3 行目（c0 と π² に依る行）: X := 12c0(1+c0) ≥ 11.22 > 0、π² ≤ 9.8697 の下で π²/X ≤ 9.8697/X ≤ 9.8697/11.22。
# 差 9.8697/X - π²/X = (9.8697 - π²)/X ≥ 0、9.8697/11.22 - 9.8697/X = 9.8697 (X - 11.22)/(11.22 X) ≥ 0 を QQ(X, q) で。
K = PolynomialRing(QQ, 'X,q').fraction_field(); X, q = K.gens()
assert pi2_up/X - q/X == (pi2_up - q)/X
assert pi2_up/(QQ(1122)/100) - pi2_up/X == pi2_up*(X - QQ(1122)/100)/((QQ(1122)/100)*X)
# 準備の逆数の鎖: 1/X = (11.22/X)(1/11.22)、差 X/X·(1/11.22) - (11.22/X)(1/11.22) = (X - 11.22)/(11.22X)、X/X·(1/11.22) = 1/11.22
assert 1/X == (QQ(1122)/100/X)*(1/(QQ(1122)/100)) and (X/X)*(1/(QQ(1122)/100)) - (QQ(1122)/100/X)*(1/(QQ(1122)/100)) == (X - QQ(1122)/100)/((QQ(1122)/100)*X) and (X/X)*(1/(QQ(1122)/100)) == 1/(QQ(1122)/100)
print("準備の逆数の鎖と B の鎖の 2〜6 行目の差の式が QQ(X, π²) と QQ で成り立つ")
worst = pi2_up / (12*lo*(1 + lo))
assert worst <= QQ(88)/100
print(f"入力の範囲の最悪の場合 9.8697/(12·0.5887·1.5887) = {worst.n(20)} ≤ 0.88 が QQ で成り立つ")
RBF = RealBallField(256); PI = RBF.pi()
c0 = 1 - PI^2/24
assert (c0 - lo).lower() >= 0
B = PI^2 / (12*c0*(1 + c0))
assert (QQ(88)/100 - B).lower() > 0
Xb = 12*c0*(1 + c0)
assert (Xb - QQ(1122)/100).lower() >= 0 and (QQ(100)/1122 - 1/Xb).lower() >= 0       # 12c0(1+c0) ≥ 11.22、準備の逆数の鎖の結論
assert (pi2_up/Xb - B).lower() >= 0 and (pi2_up/(QQ(1122)/100) - pi2_up/Xb).lower() >= 0  # B の鎖の 2・3 行目の大小
print(f"π のボールで B = {B.mid().n(30)} ≤ 0.88 と、B の鎖の 2・3 行目・準備の逆数の鎖の大小が確定する")
lo_bad = QQ(58)/100
assert pi2_up / (12*lo_bad*(1 + lo_bad)) > QQ(88)/100
print("対照: c0 の下界を 0.58 に粗くすると 9.8697/(12·0.58·1.58) > 0.88 で示せない")
print("RESULT: PASS")
