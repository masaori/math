{
  // コンパイラ設定は、入力言語の正本であるシステム（リポジトリ直下 structured-latex/）が持つ
  // tsconfig.base.json を共有する（同じリポジトリ内で strict の水準を二重管理しないため）。
  "extends": "../../structured-latex/tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    // Node 22.18+ の型ストリップで .ts を直接実行する。ビルド成果物を持たないため、
    // 相対 import は実行時に解決できる `.ts` 拡張子で書き、tsc は検査専用（noEmit）にする。
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "schema.ts",
    "labels.generated.ts",
    "document.generated.ts",
    "content",
    "notes",
    "tools",
    "type-tests",
    // 同じプロジェクトの検証スクリプト（構造化テキストのラベルに依存する）も検査対象にする。
    "../sagemath/tools"
  ],
  "exclude": ["type-tests/.tmp", "node_modules"]
}
