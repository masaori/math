{
  "name": "@finite-graph-ising-partition-polynomial/structured-latex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "任意の有限グラフ上の Ising 分配多項式と代数的 Fisher 零点を記述する構造化本文。",
  "scripts": {
    "gen": "node ../../structured-latex/codegen/structured-text-index/cli.ts --project .",
    "check:generated": "node ../../structured-latex/codegen/structured-text-index/cli.ts --project . --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:connection": "node tools/verify-hyperbolic-connection.ts",
    "verify:organization": "node tools/verify-chapter-organization.ts",
    "validate": "node tools/validate-content.ts",
    "build:tex": "node tools/build-latex.ts",
    "build:html": "node tools/build-html.ts",
    "build:pdf": "node tools/build-latex.ts --pdf",
    "check": "npm run check:generated && npm run typecheck && npm run validate && npm run verify:organization && npm run verify:connection && npm run build:tex && npm run build:html"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "katex": "^0.18.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
